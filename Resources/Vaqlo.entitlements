<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Доступ к микрофону под Hardened Runtime (приложение НЕ в сэндбоксе: нужны
	     Core Audio taps, перечисление процессов, глобальный хоткей, запуск бинарей). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Чтение Календаря (EventKit) под Hardened Runtime: без этого ключа macOS молча
	     отказывает в доступе и даже не показывает запрос. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- Общий контейнер с виджетом Control Center (статус записи). Формат TEAMID.* —
	     для Developer ID без provisioning profile; «group.*» macOS игнорирует. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>975ZZPJQNB.com.vaqlo</string>
	</array>
</dict>
</plist>
